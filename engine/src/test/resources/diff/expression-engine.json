  "cases": [
    {
      "id": "label-simple",
      "args": {
        "body": {
          "method": "labelFromFilename",
          "fileName": "joy.png"
        }
      },
      "expected": "joy"
    },
    {
      "id": "label-suffix-dash",
      "args": {
        "body": {
          "method": "labelFromFilename",
          "fileName": "joy-1.png"
        }
      },
      "expected": "joy"
    },
    {
      "id": "label-suffix-dot",
      "args": {
        "body": {
          "method": "labelFromFilename",
          "fileName": "joy.expressive.png"
        }
      },
      "expected": "joy"
    },
    {
      "id": "label-no-ext",
      "args": {
        "body": {
          "method": "labelFromFilename",
          "fileName": "sad"
        }
      },
      "expected": "sad"
    },
    {
      "id": "label-unicode",
      "args": {
        "body": {
          "method": "labelFromFilename",
          "fileName": "微笑-1.png"
        }
      },
      "expected": "微笑"
