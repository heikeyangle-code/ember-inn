    {
      "id": "image-data",
      "args": {
        "body": {
          "method": "imageData",
          "sprite": {
            "label": "joy",
            "path": "/characters/Alice/joy.png?t=2026"
          },
          "customLabels": []
        }
      },
      "expected": {
        "expression": "joy",
        "fileName": "joy.png",
        "title": "joy",
        "imageSrc": "/characters/Alice/joy.png?t=2026",
        "type": "success"
      }
    },
    {
      "id": "image-data-custom",
      "args": {
        "body": {
          "method": "imageData",
          "sprite": {
            "label": "cool",
            "path": "/characters/Alice/cool-1.png"
          },
          "settings": {
            "expressions": {
              "custom": [
                "cool"
              ]
            }
          }
        }
      },
      "expected": {
        "expression": "cool",
        "fileName": "cool-1.png",
        "title": "cool-1",
        "imageSrc": "/characters/Alice/cool-1.png",
        "type": "success",
        "isCustom": true
      }
    },
    {
      "id": "group-basic",
      "args": {
        "body": {
          "method": "groupSprites",
          "sprites": [
            {
              "label": "joy",
              "path": "/characters/A/joy.png"
            },
            {
              "label": "joy",
              "path": "/characters/A/joy-2.png"
            },
            {
              "label": "joy",
              "path": "/characters/A/joy-1.png"
            },
            {
              "label": "sad",
              "path": "/characters/A/sad.png"
            }
          ],
          "customLabels": []
        }
      },
      "expected": [
        {
          "label": "joy",
          "files": [
            {
              "expression": "joy",
              "fileName": "joy.png",
              "title": "joy",
              "imageSrc": "/characters/A/joy.png",
              "type": "success"
            },
            {
              "expression": "joy",
              "fileName": "joy-1.png",
              "title": "joy-1",
              "imageSrc": "/characters/A/joy-1.png",
              "type": "additional"
            },
            {
              "expression": "joy",
              "fileName": "joy-2.png",
              "title": "joy-2",
              "imageSrc": "/characters/A/joy-2.png",
              "type": "additional"
            }
          ]
        },
        {
          "label": "sad",
          "files": [
            {
              "expression": "sad",
              "fileName": "sad.png",
              "title": "sad",
              "imageSrc": "/characters/A/sad.png",
              "type": "success"
            }
          ]
        }
      ]
    },
    {
