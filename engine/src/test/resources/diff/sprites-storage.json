{
  "source": "sprites.js getSpritesPath/importRisuSprites",
  "cases": [
    {
      "id": "path-simple",
      "args": {
        "body": {
          "method": "path",
          "name": "Alice"
        }
      },
      "expected": "/chars/Alice"
    },
    {
      "id": "path-subfolder",
      "args": {
        "body": {
          "method": "path",
          "name": "Alice/礼服",
          "isSubfolder": true
        }
      },
      "expected": "/chars/Alice/礼服"
    },
    {
      "id": "path-invalid",
      "args": {
        "body": {
          "method": "path",
          "name": "a/b:c"
        }
      },
      "expected": "/chars/abc"
    },
    {
      "id": "risu-basic",
      "args": {
        "body": {
          "method": "risu",
          "data": {
            "data": {
              "name": "Alice",
              "extensions": {
                "risuai": {
                  "additionalAssets": [
                    [
                      "happy",
                      "SEA="
                    ],
                    [
                      "sad",
                      "U0FE"
                    ]
                  ],
                  "emotions": [
                    [
                      "angry",
                      "QU5H"
                    ]
                  ]
                }
              }
            }
          }
        }
      },
      "expected": {
        "writtenFiles": [
          {
            "spritesPath": "/chars/Alice",
            "filename": "happy.png"
          },
          {
            "spritesPath": "/chars/Alice",
            "filename": "sad.png"
          },
          {
            "spritesPath": "/chars/Alice",
            "filename": "angry.png"
          }
        ],
        "data": {
          "data": {
            "name": "Alice",
            "extensions": {
              "risuai": {}
            }
          }
        }
      }
    },
