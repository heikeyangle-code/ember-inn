          "messages": [
            {
              "role": "user",
              "content": "search"
            },
            {
              "role": "assistant",
              "tool_calls": [
                {
                  "id": "tc1",
                  "function": {
                    "name": "search",
                    "arguments": "{\"q\":\"cats\"}"
                  }
                }
              ]
            },
            {
              "role": "tool",
              "content": "结果",
              "tool_call_id": "tc1"
            }
          ]
        }
      },
      "expected": {
        "contents": [
          {
            "role": "user",
            "parts": [
              {
                "text": "search"
              }
            ]
          },
          {
            "role": "model",
            "parts": [
              {
                "functionCall": {
                  "name": "search",
                  "args": {
                    "q": "cats"
                  }
                },
                "thoughtSignature": "skip_thought_signature_validator"
              }
            ]
          },
          {
            "role": "user",
            "parts": [
              {
                "functionResponse": {
                  "name": "search",
                  "response": {
                    "name": "search",
                    "content": "结果"
                  }
                }
              }
            ]
          }
        ],
