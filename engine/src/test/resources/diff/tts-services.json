    {
      "id": "001-elevenlabs-defaults-turbo",
      "kind": "elevenlabs",
      "args": {
        "settings": {
          "stability": 0.75,
          "similarity_boost": 0.75,
          "style_exaggeration": 0,
          "speaker_boost": true,
          "speed": 1,
          "model": "eleven_turbo_v2_5"
        },
        "text": "hello world",
        "voiceId": "21m00Tcm4TlvDq8ikWAM"
      },
      "expected": {
        "voiceId": "21m00Tcm4TlvDq8ikWAM",
        "request": {
          "model_id": "eleven_turbo_v2_5",
          "text": "hello world",
          "voice_settings": {
            "stability": 0.75,
            "similarity_boost": 0.75,
            "speed": 1
          }
        }
      }
    },
