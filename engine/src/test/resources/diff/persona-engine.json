    {
      "id": "states-default-chat",
      "args": {
        "body": {
          "method": "states",
          "avatarId": "a",
          "powerUser": {
            "default_persona": "d",
            "persona_descriptions": {
              "a": {
                "connections": [
                  {
                    "type": "character",
                    "id": "char1"
                  }
                ],
                "description": "A"
              },
              "b": {
                "connections": [
                  {
                    "type": "group",
                    "id": "g1"
                  }
                ]
              },
              "c": {
                "connections": []
              }
            },
            "persona_description": "默认描述",
            "persona_description_position": 0,
            "persona_description_depth": 4,
            "persona_description_role": 0,
            "persona_description_lorebook": ""
          },
          "chatPersona": "a",
          "selectedGroup": null,
          "charAvatar": "char1"
        }
      },
      "expected": {
        "avatarId": "a",
        "default": false,
        "locked": {
          "chat": true,
          "character": true
        }
      }
    },
