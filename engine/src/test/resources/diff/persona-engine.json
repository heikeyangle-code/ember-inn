    {
      "id": "temporary-chat",
      "args": {
        "body": {
          "method": "temporary",
          "userAvatar": "a",
          "chatPersona": "b",
          "defaultPersona": "d",
          "personas": {
            "a": "A",
            "b": "B",
            "d": "D"
          }
        }
      },
      "expected": {
        "isTemporary": true,
        "hasDifferentChatLock": true,
        "hasDifferentDefaultLock": true,
        "info": "Current: A Chat: B Default: D"
      }
    },
