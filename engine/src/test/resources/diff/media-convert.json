{
  "source": "prompt-converters.js 媒体块转换（逐字提取）",
  "cases": [
    {
      "id": "claude-image",
      "args": {
        "body": {
          "target": "claude",
          "part": {
            "type": "image_url",
            "image_url": {
              "url": "data:image/png;base64,AAAA"
            }
          }
        }
      },
      "expected": {
        "type": "image",
        "source": {
          "type": "base64",
          "media_type": "image/png",
          "data": "AAAA"
        }
      }
    },
    {
      "id": "claude-text",
      "args": {
        "body": {
          "target": "claude",
          "part": {
            "type": "text",
            "text": "hello"
          }
        }
      },
      "expected": {
        "type": "text",
        "text": "hello"
      }
    },
    {
      "id": "claude-text-empty",
      "args": {
        "body": {
          "target": "claude",
          "part": {
            "type": "text",
            "text": ""
          }
        }
      },
      "expected": {
        "type": "text",
        "text": "​"
      }
    },
    {
      "id": "claude-text-name",
      "args": {
        "body": {
          "target": "claude",
          "part": {
            "type": "text",
            "text": "hi"
          },
          "name": "Alice"
        }
      },
      "expected": {
        "type": "text",
        "text": "Alice: hi"
      }
    },
