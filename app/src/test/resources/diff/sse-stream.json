{
  "source": "sse-stream.js parseStreamData",
  "cases": [
    {
      "id": "openai-delta",
      "args": {
        "body": {
          "json": {
            "choices": [
              {
                "index": 0,
                "delta": {
                  "content": "hi"
                }
              }
            ]
          }
        }
      },
      "expected": [
        {
          "data": {
            "choices": [
              {
                "index": 0,
                "delta": {
                  "content": "h"
                }
              }
            ]
          },
          "chunk": "h"
        },
        {
          "data": {
            "choices": [
              {
                "index": 0,
                "delta": {
                  "content": "i"
                }
              }
            ]
          },
          "chunk": "i"
        }
      ]
    },
    {
