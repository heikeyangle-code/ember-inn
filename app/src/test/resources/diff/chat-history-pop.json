{
  "source": "openai.js populateChatHistory",
  "cases": [
    {
      "id": "basic",
      "args": {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "你好",
              "name": "User",
              "injected": false
            },
            {
              "role": "assistant",
              "content": "回应",
              "name": "Char",
              "injected": false
            },
            {
              "role": "user",
              "content": "{{char}}再说",
              "name": "User",
              "injected": false
            }
          ],
          "new_chat_prompt": "【新会话】"
        }
      },
      "expected": [
        {
          "name": "chatHistory",
          "msgs": [
            {
              "role": "system",
              "content": "【新会话】",
              "identifier": "newMainChat"
            },
            {
              "role": "user",
              "content": "你好",
              "identifier": "chatHistory-1"
            },
            {
              "role": "assistant",
              "content": "回应",
              "identifier": "chatHistory-2"
            },
            {
              "role": "user",
              "content": "再说",
              "identifier": "chatHistory-3"
            }
          ]
        }
      ]
    },
