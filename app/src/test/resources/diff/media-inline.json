{
  "source": "openai.js Message 媒体内联纯逻辑",
  "cases": [
    {
      "id": "image-empty",
      "args": {
        "body": {
          "content": "",
          "image": "https://x/a.png"
        }
      },
      "expected": [
        {
          "type": "text",
          "text": ""
        },
        {
          "type": "image_url",
          "image_url": {
            "url": "https://x/a.png",
            "detail": "auto"
          }
        }
      ]
    },
    {
      "id": "image-text",
      "args": {
        "body": {
          "content": "hello",
          "image": "data:image/png;base64,AAAA"
        }
      },
      "expected": [
        {
          "type": "text",
          "text": "hello"
        },
        {
          "type": "image_url",
          "image_url": {
            "url": "data:image/png;base64,AAAA",
            "detail": "auto"
          }
        }
      ]
    },
    {
      "id": "video-text",
      "args": {
        "body": {
          "content": "hi",
          "video": "https://x/a.mp4",
          "quality": "low"
        }
      },
      "expected": [
        {
          "type": "text",
          "text": "hi"
        },
        {
          "type": "video_url",
          "video_url": {
            "url": "https://x/a.mp4",
            "detail": "low"
          }
        }
      ]
    },
    {
      "id": "audio-text",
      "args": {
        "body": {
          "content": "hi",
          "audio": "data:audio/mpeg;base64,BBBB"
        }
      },
      "expected": [
        {
          "type": "text",
          "text": "hi"
        },
        {
          "type": "audio_url",
          "audio_url": {
            "url": "data:audio/mpeg;base64,BBBB"
          }
        }
      ]
    },
    {
      "id": "all",
      "args": {
        "body": {
          "content": "msg",
          "image": "https://x/a.png",
          "video": "https://x/a.mp4",
          "audio": "https://x/a.mp3"
        }
      },
      "expected": [
        {
          "type": "text",
          "text": "msg"
        },
        {
          "type": "image_url",
          "image_url": {
            "url": "https://x/a.png",
            "detail": "auto"
          }
        },
        {
          "type": "video_url",
          "video_url": {
            "url": "https://x/a.mp4",
            "detail": "auto"
          }
        },
        {
          "type": "audio_url",
          "audio_url": {
            "url": "https://x/a.mp3"
          }
        }
      ]
    },
    {
      "id": "already-array",
      "args": {
        "body": {
          "content": [
            {
              "type": "text",
              "text": "x"
            }
          ],
          "image": "https://x/a.png"
        }
      },
      "expected": [
        {
          "type": "text",
          "text": "x"
        },
        {
          "type": "image_url",
          "image_url": {
            "url": "https://x/a.png",
            "detail": "auto"
          }
        }
      ]
    },
    {
      "id": "empty-no-media",
      "args": {
        "body": {
          "content": ""
        }
      },
      "expected": ""
    }
  ]
}