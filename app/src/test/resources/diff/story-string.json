{
  "source": "power-user.js renderStoryString（Handlebars noEscape）",
  "cases": [
    {
      "id": "default-full",
      "args": {
        "template": "{{#if system}}{{system}}\n{{/if}}{{#if description}}{{description}}\n{{/if}}{{#if personality}}{{char}}'s personality: {{personality}}\n{{/if}}{{#if scenario}}Scenario: {{scenario}}\n{{/if}}{{#if persona}}{{persona}}\n{{/if}}",
        "params": {
          "system": "You are Alice.",
          "description": "A curious explorer.",
          "personality": "witty",
          "scenario": "In a library.",
          "persona": "The user is a librarian.",
          "char": "Alice",
          "user": "Bob",
          "wiBefore": "WI before",
          "wiAfter": "WI after",
          "mesExamples": "",
          "anchorBefore": "",
          "anchorAfter": ""
        }
      },
      "expected": "You are Alice.\nA curious explorer.\nAlice's personality: witty\nScenario: In a library.\nThe user is a librarian.\n"
    },
    {
