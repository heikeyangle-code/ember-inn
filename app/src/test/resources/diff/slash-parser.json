{
  "source": "SlashCommandParser parseCommand core",
  "cases": [
    {
      "id": "basic-named-unnamed",
      "args": {
        "body": {
          "text": "/sendas name=柳春娘 at=1 你好啊"
        }
      },
      "expected": {
        "name": "sendas",
        "named": {
          "name": "柳春娘",
          "at": "1"
        },
        "unnamed": [
          "你好啊"
        ],
        "index": 25
      }
    },
    {
      "id": "quoted-unnamed",
      "args": {
        "body": {
          "text": "/sys \"hello world\""
        }
      },
      "expected": {
        "name": "sys",
        "named": {},
        "unnamed": [
          "\"hello world\""
        ],
        "index": 18
      }
    },
    {
      "id": "quoted-named",
      "args": {
        "body": {
          "text": "/persona name=\"柳 春 娘\""
        }
      },
      "expected": {
        "name": "persona",
        "named": {
          "name": "柳 春 娘"
        },
        "unnamed": [],
        "index": 21
      }
    },
